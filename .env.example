# oxio environment. Copy this file to `.env` and fill in what you need.
# Secrets live here, never in config.toml. oxio loads a .env from these paths,
# first value wins per key:
#   <config-dir>/PRIVATE/.env   (config-dir = ~/.config/oxio on Linux,
#   <config-dir>/.env            ~/Library/Application Support/oxio on macOS)
#   ./PRIVATE/.env
#   ./.env

# --- Web search: set ONE backend (without it, web_search is off and the agent
# falls back to web_fetch) ---

# Brave (independent index):
# OXIO_SEARCH_BACKEND=brave
# OXIO_SEARCH_API_KEY=

# Google (programmable search): also needs the engine id in OXIO_SEARCH_CX
# OXIO_SEARCH_BACKEND=google
# OXIO_SEARCH_API_KEY=
# OXIO_SEARCH_CX=

# Tavily (agent-optimized, returns extracted content):
# OXIO_SEARCH_BACKEND=tavily
# OXIO_SEARCH_API_KEY=

# SearXNG (self-hosted, keyless): point at your instance
# OXIO_SEARCH_BACKEND=searxng
# OXIO_SEARCH_URL=

# --- Cloud provider API keys ---
# One per provider, named OXIO_<PROVIDER>_API_KEY where <PROVIDER> is the
# provider's name in config.toml, uppercased. Example for a provider named "openai":
# OXIO_OPENAI_API_KEY=

# --- Optional ---
# OXIO_SANDBOX=1              # run shell commands inside the macOS seatbelt sandbox
# OXIO_IMAGE_QUALITY=medium   # low | medium | high, for generate_image
